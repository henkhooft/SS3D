/* Character Creator — Phase B guided-steps visual (design option 1A). */

.char-creator {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 22, 22, 0.9);
}

.char-creator__window {
    width: 1200px;
    height: 780px;
    flex-direction: column;
    background-color: var(--ss3d-surface-void);
    border-width: 1px;
    border-color: var(--lobby-border-subtle);
    border-style: solid;
}

.char-creator__top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    background-color: var(--lobby-surface-raised);
    border-bottom-width: 1px;
    border-bottom-color: var(--lobby-border-subtle);
    border-bottom-style: solid;
    flex-shrink: 0;
}

.char-creator__title {
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--ss3d-text-primary);
}

.char-creator__top-right {
    flex-direction: row;
    align-items: center;
}

.char-creator__loadout-wrap {
    position: relative;
    margin-right: 16px;
}

.char-creator__loadout-btn {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    background-color: #2a2a2e;
}

.char-creator__loadout-thumb {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.char-creator__loadout-name {
    font-size: 12px;
    color: var(--ss3d-text-primary);
    margin-right: 10px;
}

.char-creator__loadout-chevron {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ss3d-text-tertiary);
}

.char-creator__loadout-menu {
    position: absolute;
    top: 44px;
    right: 0;
    width: 220px;
    background-color: #2a2a2e;
    border-width: 1px;
    border-color: #5c5955;
    border-style: solid;
}

.char-creator__loadout-row {
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
}

.char-creator__loadout-row--active {
    background-color: var(--lobby-surface-raised);
}

.char-creator__loadout-row-thumb {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.char-creator__loadout-row-name {
    font-size: 12px;
    color: var(--ss3d-text-secondary);
}

.char-creator__loadout-new {
    padding: 9px 12px;
    border-top-width: 1px;
    border-top-color: var(--lobby-border-subtle);
    border-top-style: solid;
}

.char-creator__loadout-new-label {
    font-size: 11px;
    letter-spacing: 1px;
    color: #5f86b3;
}

.char-creator__return {
    height: 32px;
    padding: 0 14px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lobby-btn-blue);
    color: var(--ss3d-text-on-accent);
    font-size: 12px;
    letter-spacing: 1px;
}

.char-creator__return:hover {
    background-color: var(--lobby-btn-blue-hover);
}

.char-creator__main {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.char-creator__rail {
    width: 190px;
    flex-shrink: 0;
    background-color: var(--lobby-surface-panel);
    border-right-width: 1px;
    border-right-color: var(--lobby-border-subtle);
    border-right-style: solid;
    padding-top: 24px;
    padding-bottom: 24px;
}

.char-creator__rail-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 24px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-left-style: solid;
    background-color: rgba(0, 0, 0, 0);
}

.char-creator__rail-item--active {
    border-left-color: var(--ss3d-accent-rust);
    background-color: #2a2a2e;
}

.char-creator__rail-num {
    width: 16px;
    font-size: 11px;
    color: var(--ss3d-text-tertiary);
    margin-right: 12px;
    flex-shrink: 0;
}

.char-creator__rail-item--active .char-creator__rail-num {
    color: var(--ss3d-text-secondary);
}

.char-creator__rail-label {
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--ss3d-text-tertiary);
}

.char-creator__rail-item--active .char-creator__rail-label {
    color: var(--ss3d-text-primary);
}

.char-creator__body {
    flex-grow: 1;
    min-width: 0;
    padding: 28px 32px;
    flex-direction: column;
    background-color: #353538;
}

.char-creator__form {
    flex-direction: column;
    max-width: 420px;
}

.char-creator__form--wide {
    max-width: 520px;
}

.char-creator__field-label {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--ss3d-text-tertiary);
    margin-bottom: 6px;
    margin-top: 12px;
}

.char-creator__input {
    height: 40px;
    margin: 0;
    padding: 0;
    background-color: #2a2a2e;
    border-width: 1px;
    border-color: #5c5955;
    border-style: solid;
    border-radius: 0;
    color: var(--ss3d-text-primary);
}

.char-creator__input > .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
}

.char-creator__input > .unity-base-text-field__input,
.char-creator__input > .unity-text-field__input,
.char-creator__input > .unity-base-field__input {
    flex-grow: 1;
    height: 100%;
    margin: 0;
    padding: 10px 12px;
    background-color: #2a2a2e;
    border-width: 0;
    color: var(--ss3d-text-primary);
}

.char-creator__species-row {
    flex-direction: row;
}

.char-creator__species-chip {
    height: 34px;
    padding: 0 12px;
    margin-right: 6px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lobby-surface-raised);
    color: var(--ss3d-text-secondary);
    font-size: 11px;
    letter-spacing: 1px;
}

.char-creator__species-chip--active {
    background-color: var(--lobby-btn-blue);
    color: var(--ss3d-text-on-accent);
}

.char-creator__swatch-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.char-creator__swatch {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    margin-bottom: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-style: solid;
}

.char-creator__swatch--small {
    width: 24px;
    height: 24px;
}

.char-creator__swatch--selected {
    border-color: var(--ss3d-text-primary);
}

.char-creator__section {
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--ss3d-text-primary);
    margin-bottom: 12px;
}

.char-creator__slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 11px;
}

.char-creator__slider-label {
    width: 76px;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--ss3d-text-secondary);
}

.char-creator__slider-value {
    width: 36px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--ss3d-text-primary);
    background-color: #2a2a2e;
    border-width: 1px;
    border-color: #5c5955;
    border-style: solid;
    -unity-text-align: middle-center;
    margin-right: 8px;
    padding: 4px 0;
}

.char-creator__slider {
    flex-grow: 1;
    height: 14px;
    margin: 0;
}

.char-creator__slider .unity-base-slider__tracker {
    background-color: #2a2a2e;
    border-width: 0;
    border-radius: 0;
    height: 14px;
}

.char-creator__slider .unity-base-slider__dragger {
    width: 5px;
    height: 18px;
    background-color: var(--ss3d-text-primary);
    border-width: 0;
    border-radius: 0;
    margin-top: -2px;
}

.char-creator__slider .unity-base-slider__fill {
    background-color: #b13d3d;
    border-radius: 0;
}

.char-creator__style-tabs {
    flex-direction: row;
    background-color: var(--lobby-surface-raised);
    margin-bottom: 12px;
    align-self: flex-start;
}

.char-creator__style-tab {
    height: 34px;
    padding: 0 16px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--ss3d-text-tertiary);
    font-size: 11px;
    letter-spacing: 1px;
}

.char-creator__style-tab--active {
    background-color: #2a2a2e;
    color: var(--ss3d-text-primary);
}

.char-creator__style-scroll {
    flex-grow: 1;
    max-height: 340px;
    min-height: 180px;
}

.char-creator__style-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.char-creator__style-tile {
    width: 76px;
    height: 76px;
    margin-right: 10px;
    margin-bottom: 10px;
    background-color: #2a2a2e;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-style: solid;
    align-items: center;
    justify-content: center;
    padding: 6px;
}

.char-creator__style-tile--selected {
    border-color: var(--ss3d-accent-rust);
}

.char-creator__style-none {
    font-size: 16px;
    color: var(--ss3d-feedback-danger);
    margin-bottom: 4px;
}

.char-creator__style-tile-label {
    font-size: 10px;
    letter-spacing: 0.5px;
    color: var(--ss3d-text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
}

.char-creator__review-title {
    font-size: 20px;
    letter-spacing: 1px;
    color: var(--ss3d-text-primary);
    margin-bottom: 16px;
}

.char-creator__review-card {
    background-color: #2a2a2e;
    padding: 16px;
    margin-bottom: 16px;
}

.char-creator__review-line {
    margin-bottom: 8px;
}

.char-creator__review-text {
    font-size: 13px;
    color: var(--ss3d-text-secondary);
}

.char-creator__save {
    width: 220px;
    height: 44px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lobby-btn-green);
    color: var(--ss3d-text-on-accent);
    font-size: 14px;
    letter-spacing: 1px;
}

.char-creator__save:hover {
    background-color: var(--lobby-btn-green-hover);
}

.char-creator__nav {
    flex-direction: row;
    margin-top: 32px;
}

.char-creator__nav-btn {
    height: 40px;
    padding: 0 20px;
    margin-right: 10px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lobby-surface-raised);
    color: var(--ss3d-text-primary);
    font-size: 12px;
    letter-spacing: 1px;
}

.char-creator__nav-btn--primary {
    background-color: var(--lobby-btn-blue);
    color: var(--ss3d-text-on-accent);
}

.char-creator__nav-btn:disabled {
    opacity: 0.4;
}

.char-creator__preview-dock {
    width: 360px;
    flex-shrink: 0;
    background-color: var(--lobby-surface-panel);
    border-left-width: 1px;
    border-left-color: var(--lobby-border-subtle);
    border-left-style: solid;
    padding: 20px;
    flex-direction: column;
}

.char-creator__preview-frame {
    flex-grow: 1;
    min-height: 0;
    background-color: #2a2a2e;
    border-width: 1px;
    border-color: #5c5955;
    border-style: solid;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 12px;
}

.char-creator__preview-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.char-creator__angle-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.char-creator__angle-btn {
    width: 30px;
    height: 30px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lobby-surface-raised);
    color: var(--ss3d-text-primary);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.char-creator__angle-label {
    min-width: 52px;
    margin-left: 16px;
    margin-right: 16px;
    font-size: 12px;
    color: var(--ss3d-text-tertiary);
    -unity-text-align: middle-center;
}
