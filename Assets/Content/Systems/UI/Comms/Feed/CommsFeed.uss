/*
 * Non-diegetic comms feed — radio stack (left) + all-station banner (top).
 * Visual language matches the Claude Design radio / ALL-STATION mocks.
 */

@import url("../../Tokens/ss3d-tokens.uss");
@import url("../../Tokens/ss3d-typography.uss");

.comms-feed {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
}

.comms-feed__radio-stack {
    position: absolute;
    left: 16px;
    top: 0;
    bottom: 0;
    width: 320px;
    flex-direction: column-reverse;
    justify-content: center;
    align-items: flex-start;
}

.comms-feed__radio-card {
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(18, 28, 42, 0.72);
    border-left-width: 2px;
    border-left-color: rgb(95, 134, 179);
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    padding: 7px 12px 8px 12px;
    margin-top: 6px;
    max-width: 320px;
    min-width: 220px;
}

.comms-feed__radio-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin: 0;
    padding: 0;
}

.comms-feed__radio-header {
    margin: 0;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/SpessmanFontSDF.asset");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(95, 134, 179);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.comms-feed__radio-sender {
    margin: 0 0 0 8px;
    padding: 0;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/SpessmanFontSDF.asset");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(170, 185, 200);
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.comms-feed__radio-body {
    margin-top: 2px;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/SpessmanFontSDF.asset");
    font-size: 19px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    white-space: normal;
}

.comms-feed__announce {
    position: absolute;
    top: 0;
    /* left set in code: panelWidth/2 - width/2 (avoid USS translate:-50% staleness) */
    min-width: 360px;
    max-width: 560px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(48, 36, 22, 0.88);
    border-top-width: 2px;
    border-top-color: rgb(230, 173, 83);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding: 8px 24px 10px 24px;
}

.comms-feed__announce-title {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/OdetoIdleGamingSDF.asset");
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(240, 196, 125);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.comms-feed__announce-body {
    margin-top: 2px;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/GurajadaRegularSDF.asset");
    font-size: 21px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
}
