@import url("../Tokens/ss3d-tokens.uss");
@import url("../Tokens/ss3d-typography.uss");

:root {
    --map-editor-toolbar-bg: var(--ss3d-surface-panel);
    --map-editor-accent: var(--ss3d-accent-rust);
}

.map-editor-root {
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-editor-hidden {
    display: none;
}

.map-editor-toolbar-strip {
    flex-direction: row;
    align-items: center;
    background-color: var(--map-editor-toolbar-bg);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-md);
    padding: 6px;
    box-shadow: var(--ss3d-shadow-window);
}

.map-editor-toolbar-strip > * {
    margin-left: 3px;
    margin-right: 3px;
}

.map-editor-icon-btn {
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    background-color: var(--ss3d-surface-elevated);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-sm);
    color: var(--ss3d-text-primary);
}

.map-editor-icon-btn:hover {
    background-color: var(--ss3d-surface-panel-raised);
}

.map-editor-icon-btn--active {
    background-color: var(--ss3d-accent-rust-dim);
    border-color: var(--map-editor-accent);
    color: var(--ss3d-text-on-accent);
}

.map-editor-icon-btn--disabled {
    color: var(--ss3d-text-tertiary);
}

.map-editor-separator {
    width: 1px;
    align-self: stretch;
    background-color: var(--ss3d-border-default);
    margin-top: 2px;
    margin-bottom: 2px;
}

.map-editor-exit-btn {
    padding-left: 12px;
    padding-right: 12px;
    height: 36px;
    background-color: var(--ss3d-surface-elevated);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-sm);
    color: var(--ss3d-text-primary);
}

.map-editor-exit-btn:hover {
    background-color: var(--ss3d-surface-panel-raised);
}

.map-editor-region {
    position: absolute;
}

.map-editor-region--top-left { left: 24px; top: 24px; }
.map-editor-region--top-center { left: 50%; top: 24px; translate: -50% 0; }
.map-editor-region--top-right { right: 24px; top: 24px; }
.map-editor-region--selected { left: 50%; top: 108px; translate: -50% 0; }
.map-editor-region--bottom { left: 24px; right: 24px; bottom: 24px; height: 336px; }

.map-editor-window {
    background-color: var(--ss3d-surface-panel);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-md);
    box-shadow: var(--ss3d-shadow-window);
    padding: 12px;
}

.map-editor-window__title {
    color: var(--ss3d-text-secondary);
    -unity-font-definition: initial;
    font-size: 12px;
    margin-bottom: 8px;
    letter-spacing: 1px;
    -unity-text-align: upper-left;
}

.map-editor-mode-rail {
    width: 108px;
    background-color: var(--ss3d-surface-panel);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-md);
    padding: 8px;
    box-shadow: var(--ss3d-shadow-window);
}

.map-editor-mode-tab {
    flex-direction: column;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 6px;
    padding-right: 6px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: transparent;
    border-radius: var(--ss3d-radius-sm);
    color: var(--ss3d-text-secondary);
    -unity-text-align: middle-center;
    font-size: 11px;
    white-space: normal;
}

.map-editor-mode-tab--active {
    background-color: var(--ss3d-accent-rust-dim);
    border-color: var(--map-editor-accent);
    color: var(--ss3d-text-on-accent);
}

.map-editor-subcat-tab {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    margin-right: 4px;
    border-width: 1px;
    border-color: transparent;
    border-radius: var(--ss3d-radius-sm);
    color: var(--ss3d-text-secondary);
    font-size: 12px;
}

.map-editor-subcat-tab--active {
    background-color: var(--ss3d-accent-rust-dim);
    border-color: var(--map-editor-accent);
    color: var(--ss3d-text-on-accent);
}

.map-editor-search {
    flex-direction: row;
    align-items: center;
    background-color: var(--ss3d-surface-inset);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-sm);
    padding: 6px 10px;
    min-width: 220px;
}

.map-editor-search-field {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    color: var(--ss3d-text-primary);
    margin-left: 8px;
}

.map-editor-grid {
    flex-direction: row;
    flex-wrap: wrap;
    max-height: 190px;
    overflow: hidden;
}

.map-editor-grid-scroll {
    max-height: 190px;
}

.map-editor-slot {
    width: 72px;
    height: 84px;
    align-items: center;
    margin: 4px;
    padding: 8px 4px 6px;
    background-color: var(--ss3d-surface-panel-raised);
    border-width: 1.5px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-md);
}

.map-editor-slot--active {
    border-color: var(--map-editor-accent);
}

.map-editor-slot__icon {
    width: 34px;
    height: 34px;
    border-radius: var(--ss3d-radius-sm);
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.map-editor-slot__label {
    font-size: 10px;
    color: var(--ss3d-text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 64px;
}

.map-editor-selected-panel {
    width: 420px;
    flex-direction: row;
}

.map-editor-selected-icon {
    width: 64px;
    height: 64px;
    border-width: 1.5px;
    border-color: var(--ss3d-border-strong);
    border-radius: var(--ss3d-radius-md);
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.map-editor-selected-name {
    color: var(--ss3d-text-primary);
    font-size: 16px;
    margin-bottom: 4px;
}

.map-editor-selected-meta {
    color: var(--ss3d-text-tertiary);
    font-size: 12px;
    margin-bottom: 8px;
}

.map-editor-selected-hint {
    background-color: var(--ss3d-surface-inset);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-sm);
    padding: 6px 10px;
    font-size: 12px;
    color: var(--ss3d-text-tertiary);
}

.map-editor-selected-hint--active {
    border-color: var(--map-editor-accent);
    color: var(--map-editor-accent);
}

.map-editor-popover {
    position: absolute;
    top: 52px;
    right: 0;
    width: 260px;
    z-index: 100;
}

.map-editor-popover--wide {
    width: 300px;
}

.map-editor-toggle-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
}

.map-editor-toggle-label {
    color: var(--ss3d-text-secondary);
    font-size: 13px;
}

.map-editor-map-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ss3d-border-subtle);
}

.map-editor-map-name {
    color: var(--ss3d-text-primary);
    font-size: 13px;
}

.map-editor-action-btn {
    padding: 4px 10px;
    background-color: var(--ss3d-feedback-info-bg);
    border-width: 1px;
    border-color: var(--ss3d-feedback-info-border);
    border-radius: var(--ss3d-radius-sm);
    color: var(--ss3d-text-primary);
    font-size: 12px;
}

.map-editor-stub-message {
    color: var(--ss3d-text-tertiary);
    font-size: 13px;
    padding: 20px 8px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.map-editor-toast {
    position: absolute;
    bottom: 40px;
    left: 50%;
    translate: -50% 0;
    background-color: var(--ss3d-surface-panel-raised);
    border-width: 1px;
    border-color: var(--map-editor-accent);
    border-radius: var(--ss3d-radius-sm);
    padding: 10px 18px;
    color: var(--ss3d-text-primary);
    font-size: 13px;
    box-shadow: var(--ss3d-shadow-panel);
}

.map-editor-reveal-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    background-color: rgba(23, 26, 30, 0.7);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-sm);
    color: var(--ss3d-text-secondary);
}

.map-editor-bottom-row {
    flex-direction: row;
    flex-grow: 1;
}

.map-editor-library {
    flex-grow: 1;
    margin-left: 12px;
}

.map-editor-save-field {
    margin-top: 8px;
    margin-bottom: 8px;
    background-color: var(--ss3d-surface-inset);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    color: var(--ss3d-text-primary);
    padding: 6px;
}
