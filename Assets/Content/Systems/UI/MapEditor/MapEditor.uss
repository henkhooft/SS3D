@import url("../Tokens/ss3d-tokens.uss");
@import url("../Tokens/ss3d-typography.uss");

:root {
    --map-editor-toolbar-bg: var(--ss3d-surface-panel);
    --map-editor-accent: var(--ss3d-accent-rust);
}

.map-editor-root {
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-editor-hidden {
    display: none;
}

.map-editor-toolbar-strip {
    flex-direction: row;
    align-items: center;
    background-color: var(--map-editor-toolbar-bg);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-md);
    padding: 6px;
}

.map-editor-toolbar-strip > * {
    margin-left: 3px;
    margin-right: 3px;
}

.map-editor-toolbar-strip--vertical {
    flex-direction: column;
}

.map-editor-toolbar-strip--vertical > * {
    margin-left: 0;
    margin-right: 0;
    margin-top: 3px;
    margin-bottom: 3px;
}

.map-editor-icon-btn {
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    background-color: var(--ss3d-surface-elevated);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-sm);
    color: var(--ss3d-text-primary);
    -unity-text-align: middle-center;
    font-size: 0;
}

.map-editor-icon-btn__icon {
    width: 19px;
    height: 19px;
}

.map-editor-vector-icon {
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ss3d-text-primary);
}

.map-editor-icon-btn--active .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-on-accent);
}

.map-editor-icon-btn--disabled .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-tertiary);
}

.map-editor-mode-tab__icon {
    width: 18px;
    height: 18px;
    margin-bottom: 4px;
}

.map-editor-mode-tab .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-secondary);
}

.map-editor-mode-tab--active .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-on-accent);
}

.map-editor-mode-tab__label {
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.map-editor-subcat-tab__icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.map-editor-subcat-tab .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-secondary);
}

.map-editor-subcat-tab--active .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-on-accent);
}

.map-editor-subcat-tab__label {
    font-size: 12px;
}

.map-editor-search-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.55;
}

.map-editor-search .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-secondary);
}

.map-editor-icon-btn:hover {
    background-color: var(--ss3d-surface-panel-raised);
}

.map-editor-icon-btn--active {
    background-color: var(--ss3d-accent-rust-dim);
    border-color: var(--map-editor-accent);
    color: var(--ss3d-text-on-accent);
}

.map-editor-icon-btn--disabled {
    color: var(--ss3d-text-tertiary);
}

.map-editor-separator {
    height: 1px;
    align-self: stretch;
    background-color: var(--ss3d-border-default);
    margin-left: 2px;
    margin-right: 2px;
}

.map-editor-separator--vertical {
    height: 1px;
    width: auto;
    margin-top: 2px;
    margin-bottom: 2px;
    margin-left: 0;
    margin-right: 0;
}

.map-editor-region {
    position: absolute;
}

.map-editor-region--top-left { left: 24px; top: 24px; }
.map-editor-region--top-right { right: 24px; top: 24px; width: auto; }
.map-editor-region--bottom { left: 24px; right: 24px; bottom: 24px; height: 260px; }

.map-editor-right-column {
    flex-direction: column;
    align-items: flex-end;
}

.map-editor-right-column > * {
    margin-bottom: 12px;
}

.map-editor-window {
    background-color: var(--ss3d-surface-panel);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-md);
    padding: 12px;
}

.map-editor-window__title {
    color: var(--ss3d-text-secondary);
    -unity-font-definition: initial;
    font-size: 12px;
    margin-bottom: 8px;
    letter-spacing: 1px;
    -unity-text-align: upper-left;
}

.map-editor-popover-label {
    color: var(--ss3d-text-secondary);
    font-size: var(--ss3d-text-body-sm, 12px);
    margin-bottom: 4px;
}

/* -- Camera dial ---------------------------------------------------- */

.map-editor-camera-dial-wrap {
    align-items: center;
}

.map-editor-camera-dial {
    position: relative;
    width: 76px;
    height: 76px;
    align-items: center;
    justify-content: center;
}

.map-editor-camera-dial__ring {
    position: absolute;
    left: 10px;
    top: 10px;
    right: 10px;
    bottom: 10px;
    border-radius: 999px;
    background-color: var(--ss3d-surface-inset);
    border-width: 1.5px;
    border-color: var(--ss3d-border-strong);
}

.map-editor-camera-dial__open {
    position: absolute;
    left: 24px;
    top: 24px;
    right: 24px;
    bottom: 24px;
    border-radius: 999px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.map-editor-camera-dial__open .map-editor-vector-icon {
    width: 18px;
    height: 18px;
}

.map-editor-camera-dial__open.map-editor-icon-btn--active {
    background-color: var(--ss3d-accent-rust-dim);
}

.map-editor-camera-dial__open.map-editor-icon-btn--active .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-on-accent);
}

.map-editor-camera-dial__btn {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background-color: var(--ss3d-surface-elevated);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    align-items: center;
    justify-content: center;
    padding: 0;
}

.map-editor-camera-dial__btn-icon {
    width: 13px;
    height: 13px;
}

.map-editor-camera-dial__rotate-left {
    left: -4px;
    top: 27px;
}

.map-editor-camera-dial__rotate-right {
    right: -4px;
    top: 27px;
}

.map-editor-camera-dial__zoom-row {
    flex-direction: row;
    margin-top: 8px;
}

.map-editor-camera-dial__zoom-row > .map-editor-camera-dial__btn {
    position: relative;
    left: 0;
    top: 0;
    margin-left: 3px;
    margin-right: 3px;
}

/* -- Object library panel -------------------------------------------- */

.map-editor-mode-rail {
    width: 108px;
    background-color: var(--ss3d-surface-panel);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-md);
    padding: 8px;
}

.map-editor-mode-tab {
    padding: 0;
    margin-bottom: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.map-editor-mode-tab__surface {
    flex-direction: column;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 6px;
    padding-right: 6px;
    border-width: 1px;
    border-color: transparent;
    border-radius: var(--ss3d-radius-sm);
    background-color: rgba(0, 0, 0, 0);
    color: var(--ss3d-text-secondary);
}

.map-editor-mode-tab--active .map-editor-mode-tab__surface {
    background-color: var(--ss3d-accent-rust-dim);
    border-color: var(--map-editor-accent);
    color: var(--ss3d-text-on-accent);
}

.map-editor-mode-tab--active .map-editor-mode-tab__label {
    color: var(--ss3d-text-on-accent);
}

.map-editor-subcat-tab {
    padding: 0;
    margin-right: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.map-editor-subcat-tab__surface {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    border-width: 1px;
    border-color: transparent;
    border-radius: var(--ss3d-radius-sm);
    background-color: rgba(0, 0, 0, 0);
    color: var(--ss3d-text-secondary);
}

.map-editor-subcat-tab--active .map-editor-subcat-tab__surface {
    background-color: var(--ss3d-accent-rust-dim);
    border-color: var(--map-editor-accent);
    color: var(--ss3d-text-on-accent);
}

.map-editor-subcat-tab--active .map-editor-subcat-tab__label {
    color: var(--ss3d-text-on-accent);
}

.map-editor-search {
    flex-direction: row;
    align-items: center;
    background-color: var(--ss3d-surface-inset);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-sm);
    padding: 6px 10px;
    min-width: 220px;
}

.map-editor-search-field {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    color: var(--ss3d-text-primary);
    margin-left: 8px;
}

.map-editor-library-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--ss3d-surface-panel-raised);
    padding: 10px 14px;
    border-top-left-radius: var(--ss3d-radius-md);
    border-top-right-radius: var(--ss3d-radius-md);
}

.map-editor-library-header__title {
    color: var(--ss3d-text-primary);
    -unity-font-definition: initial;
    font-size: 13px;
    letter-spacing: 1px;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}

.map-editor-library-header__buttons {
    flex-direction: row;
    flex-shrink: 0;
}

.map-editor-header-icon-btn {
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--ss3d-radius-sm);
    padding: 0;
    margin-left: 2px;
}

.map-editor-header-icon-btn__icon {
    width: 14px;
    height: 14px;
}

.map-editor-header-icon-btn .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-tertiary);
}

.map-editor-header-icon-btn:hover {
    background-color: var(--ss3d-btn-highlighted-bg, var(--ss3d-surface-elevated));
}

.map-editor-header-icon-btn--active {
    background-color: var(--ss3d-accent-rust-dim);
}

.map-editor-header-icon-btn--active .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-on-accent);
}

.map-editor-library-body {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 14px;
}

.map-editor-grid {
    flex-direction: row;
}

.map-editor-grid-scroll {
    flex-grow: 1;
    margin-top: 10px;
}

.map-editor-grid-column {
    flex-direction: column;
    flex-shrink: 0;
}

.map-editor-slot {
    width: 88px;
    height: 104px;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-start;
    margin: 4px;
    padding: 10px 6px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1.5px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-md);
}

.map-editor-slot--active {
    border-color: var(--map-editor-accent);
}

.map-editor-slot__icon-frame {
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.map-editor-slot__icon {
    width: 48px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.map-editor-slot__icon--eraser {
    background-color: rgba(179, 51, 51, 0.35);
    border-radius: var(--ss3d-radius-sm);
}

.map-editor-slot__label {
    font-size: 11px;
    color: var(--ss3d-text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 100%;
}

.map-editor-popover {
    position: absolute;
    top: 0;
    width: 260px;
    z-index: 100;
}

.map-editor-popover--anchor-right {
    left: calc(100% + 8px);
}

.map-editor-popover--anchor-left {
    right: calc(100% + 8px);
}

.map-editor-popover--wide {
    width: 320px;
}

.map-editor-toggle-row {
    margin-top: 4px;
    margin-bottom: 4px;
    color: var(--ss3d-text-primary);
}

.map-editor-slider-row {
    margin-top: 6px;
    margin-bottom: 6px;
}

.map-editor-slider-row__label {
    color: var(--ss3d-text-secondary);
    font-size: 13px;
}

.map-editor-slider-row__value {
    color: var(--ss3d-text-primary);
    font-size: 12px;
}

.map-editor-slider-row__slider {
    margin-top: 2px;
}

.map-editor-toggle-label {
    color: var(--ss3d-text-secondary);
    font-size: 13px;
}

.map-editor-map-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ss3d-border-subtle);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-radius: 0;
    margin: 0;
}

.map-editor-map-row:hover {
    background-color: var(--ss3d-surface-panel-raised);
}

.map-editor-map-name {
    color: var(--ss3d-text-primary);
    font-size: 13px;
}

.map-editor-map-name--overwrite-target {
    color: var(--map-editor-accent);
}

.map-editor-map-badge {
    font-size: 11px;
    color: var(--ss3d-feedback-info-text, var(--ss3d-text-primary));
    background-color: var(--ss3d-feedback-info-bg);
    border-width: 1px;
    border-color: var(--ss3d-feedback-info-border);
    border-radius: var(--ss3d-radius-sm);
    padding: 2px 8px;
    margin-left: 8px;
}

.map-editor-map-badge--warning {
    color: var(--ss3d-feedback-warning-text, var(--ss3d-text-primary));
    background-color: var(--ss3d-feedback-warning-bg);
    border-color: var(--ss3d-feedback-warning-border);
}

.map-editor-action-btn {
    padding: 4px 10px;
    background-color: var(--ss3d-feedback-info-bg);
    border-width: 1px;
    border-color: var(--ss3d-feedback-info-border);
    border-radius: var(--ss3d-radius-sm);
    color: var(--ss3d-text-primary);
    font-size: 12px;
    margin-left: 8px;
}

.map-editor-action-btn--primary {
    width: 100%;
    padding: 8px 10px;
    background-color: var(--map-editor-accent);
    border-color: var(--map-editor-accent);
    color: var(--ss3d-text-on-accent);
    margin-left: 0;
    -unity-text-align: middle-center;
}

.map-editor-stub-message {
    color: var(--ss3d-text-tertiary);
    font-size: 13px;
    padding: 20px 8px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.map-editor-toast {
    position: absolute;
    bottom: 296px;
    left: 50%;
    translate: -50% 0;
    background-color: var(--ss3d-surface-panel-raised);
    border-width: 1px;
    border-color: var(--map-editor-accent);
    border-radius: var(--ss3d-radius-sm);
    padding: 10px 18px;
    color: var(--ss3d-text-primary);
    font-size: 13px;
}

.map-editor-reveal-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    background-color: rgba(23, 26, 30, 0.7);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
    border-radius: var(--ss3d-radius-sm);
    color: var(--ss3d-text-secondary);
}

.map-editor-reveal-btn .map-editor-vector-icon {
    -unity-background-image-tint-color: var(--ss3d-text-secondary);
}

.map-editor-bottom-row {
    flex-direction: row;
    flex-grow: 1;
}

.map-editor-library {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 12px;
}
